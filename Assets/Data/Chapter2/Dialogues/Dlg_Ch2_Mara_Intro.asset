  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Ch2_Mara_Intro
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_ch2_mara_intro
  lines:
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ch\xE1u ch\xE8o \u0111\xF2 t\u1EEB B\u1EDD \u0110\xF4ng sang t\u1EADn \u0111\xE2y \xE0? L\u1EA1i nghe \xF4ng Kael k\u1EC3 x\u1EA5u t\xF4i g\xEC \u0111\xFAng kh\xF4ng?"
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Wen
    textKey: "Kh\xF4ng \u0111\xE2u b\xE0 Mara, ch\xE1u ch\u1EC9 mu\u1ED1n hi\u1EC3u chuy\u1EC7n g\xEC \u0111\xE3 x\u1EA3y ra v\u1EDBi c\xE2y c\u1EA7u th\xF4i \u1EA1."
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "\u0110\xEAm b\xE3o 3 n\u0103m tr\u01B0\u1EDBc, n\u01B0\u1EDBc d\xE2ng ngang b\u1EBFn. \u0110\xE8n b\xE3o t\u1EAFt ng\xFAm m\xE0 \xF4ng \u1EA5y quay l\u01B0ng c\u1EAFt d\xE2y c\u1EA7u, b\u1ECF m\u1EB7c b\u1EDD T\xE2y t\xF4i..."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "C\xF2n l\u1ED1i l\xEAn \u0110\u1EA7m L\u1EA7y ph\xEDa B\u1EAFc kia s\u01B0\u01A1ng m\xF9 d\xE0y \u0111\u1EB7c l\u1EAFm, ch\xE1u tuy\u1EC7t \u0111\u1ED1i \u0111\u1EEBng b\xE9n m\u1EA3ng v\xE0o. T\u1ED1i xu\u1ED1ng c\u1EE9 xem quanh m\u1ED1 c\u1EA7u T\xE2y r\u1ED3i t\u1EF1 hi\u1EC3u."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  choices: []
  setsStoryFlagOnFinish: flag_ch2_met_mara
