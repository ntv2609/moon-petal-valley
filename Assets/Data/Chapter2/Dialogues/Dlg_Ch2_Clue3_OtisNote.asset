  m_Name: Dlg_Ch2_Clue3_OtisNote
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_ch2_clue3
  lines:
  - speakerNameKey: "B\xE1c Otis"
    textKey: "Ch\xE1u t\xECm th\u1EA5y s\u1ED5 ghi ch\xE9p c\u0169 c\u1EE7a b\xE1c r\u1ED3i \xE0? \u0110\xEAm b\xE3o n\u0103m \u0111\xF3 Kael ch\u1EB7t c\xE1p gi\u1EEF nh\xE0 tr\u1EBB b\u1EDD \u0110\xF4ng r\u1ED3i lao xu\u1ED1ng s\xF4ng c\u1EE9u thuy\u1EC1n cho Mara t\u1EDBi b\u1ECB th\u01B0\u01A1ng n\u1EB7ng."
    portraitOverride: {fileID: 0}
    speakerId: otis
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Wen
    textKey: "H\xF3a ra c\u1EA3 hai \u0111\u1EC1u hi\u1EC3u l\u1EA7m nhau su\u1ED1t 3 n\u0103m! M\xECnh n\xEAn n\xF3i th\u1EB3ng s\u1EF1 th\u1EADt cho b\xE0 Mara hay \u0111\u1EC3 hai ng\u01B0\u1EDDi t\u1EF1 th\u1EA5y qua \xC1nh Soi?"
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  choices:
  - choiceTextKey: "N\xF3i th\u1EB3ng s\u1EF1 th\u1EADt t\u1EEB l\u1EDDi b\xE1c Otis"
    setsFlagOnPick: flag_ch2_choice_tell_truth
    targetNpcId: 
    affinityDelta: 0
    branchDialogue: {fileID: 0}
  - choiceTextKey: "Gi\u1EEF k\xEDn chuy\u1EC7n c\u0169, \u0111\u1EC3 h\u1ECD t\u1EF1 th\u1EA5y qua \xC1nh Soi"
    setsFlagOnPick: flag_ch2_choice_keep_secret
    targetNpcId: 
    affinityDelta: 0
    branchDialogue: {fileID: 0}
