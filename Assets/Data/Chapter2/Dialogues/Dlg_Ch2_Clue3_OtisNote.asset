  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Ch2_Clue3_OtisNote
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_ch2_clue3
  lines:
  - speakerNameKey: "B\xE1c Otis"
    textKey: "Ch\xE1u \u0111\u1ECDc s\u1ED5 ghi ch\xE9p \u0111\xEAm b\xE3o 3 n\u0103m tr\u01B0\u1EDBc r\u1ED3i \xE0? \u0110\xEAm \u0111\xF3 Kael c\u1EAFt d\xE2y c\u1EA7u \u0111\u1EC3 v\xE1n g\xE3y kh\xF4ng \u0111\u1EADp s\u1EADp b\u1EBFn nh\xE0 Mara, r\u1ED3i lao xu\u1ED1ng c\u1EE9u thuy\u1EC1n t\u1EDBi b\u1ECB th\u01B0\u01A1ng."
    portraitOverride: {fileID: 0}
    speakerId: otis
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE1c Otis"
    textKey: "Mu\u1ED1n h\xF3a gi\u1EA3i hi\u1EC3u l\u1EA7m su\u1ED1t 3 n\u0103m nay, ch\xE1u c\u1EA7n t\xECm \u0111\u1EE7 Chi\u1EBFc \u0110\xE8n B\xE3o C\u1ED5 hai ng\u01B0\u1EDDi c\xF9ng r\xE8n: Khung \u0110\u1ED3ng \u1EDF ch\u1ED7 \xF4ng Kael, c\xF2n Chao K\xEDnh b\u1ECB b\xE3o cu\u1ED1n v\xE0o \u0110\u1EA7m L\u1EA7y B\u1EDD T\xE2y."
    portraitOverride: {fileID: 0}
    speakerId: otis
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Wen
    textKey: "Ra l\xE0 v\u1EADy! Ch\xE1u s\u1EBD qua g\u1EB7p \xF4ng Kael xin Khung \u0110\u1ED3ng tr\u01B0\u1EDBc. C\xF2n chuy\u1EC7n \u0111\xEAm b\xE3o, m\xECnh n\xEAn n\xF3i th\u1EB3ng cho b\xE0 Mara hay \u0111\u1EC3 hai ng\u01B0\u1EDDi t\u1EF1 th\u1EA5y qua \xC1nh Soi?"
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  choices:
  - choiceTextKey: "N\xF3i th\u1EB3ng s\u1EF1 th\u1EADt t\u1EEB l\u1EDDi b\xE1c Otis"
    setsFlagOnPick: flag_ch2_choice_tell_truth
    targetNpcId: 
    affinityDelta: 0
    branchDialogue: {fileID: 0}
  - choiceTextKey: "Gi\u1EEF k\xEDn chuy\u1EC7n c\u0169, \u0111\u1EC3 h\u1ECD t\u1EF1 th\u1EA5y qua \xC1nh Soi"
    setsFlagOnPick: flag_ch2_choice_keep_secret
    targetNpcId: 
    affinityDelta: 0
    branchDialogue: {fileID: 0}
