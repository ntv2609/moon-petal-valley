  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: dlg_bloom_climax
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_bloom_climax
  lines:
  - speakerNameKey: Tinh Linh Lumi
    textKey: "Woa! Nh\xECn k\xECa Wen! C\xE1nh hoa Moonpetal \u0111ang m\u1EDF ra... l\xE0n s\u01B0\u01A1ng t\xEDm tan s\u1EA1ch lu\xF4n r\u1ED3i!"
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "C\u1EADu B\xE9 Toby"
    textKey: "Si\xEAu ng\u1EA7u lu\xF4n ch\u1ECB Wen \u01A1i! \xC1nh tr\u0103ng bay \u0111\u1EA7y khu v\u01B0\u1EDDn th\u1EADt \u0111\u1EA5y! Miu c\u0169ng \u0111ang nh\u1EA3y l\xEAn k\xECa!"
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Hana"
    textKey: "\xD4i chao... Bao nhi\xEAu n\u0103m r\u1ED3i t\xF4i m\u1EDBi l\u1EA1i ng\u1EEDi th\u1EA5y h\u01B0\u01A1ng Moonpetal h\xF2a v\u1EDBi m\xF9i b\xE1nh n\u01B0\u1EDBng \u1EA5m \xE1p th\u1EBF n\xE0y."
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE1c Otis"
    textKey: "E h\xE8m... Theo ghi ch\xE9p b\u01B0u c\u1EE5c, \u0111\xE2y ch\xEDnh th\u1EE9c l\xE0 ng\xE0y \u0111\u1EB9p tr\u1EDDi nh\u1EA5t c\u1EE7a thung l\u0169ng trong ba n\u0103m qua."
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Bach"
    textKey: "Ch\u1EADc. B\u1ECDn tr\u1EBB c\xE1c c\xF4 c\u1EADu l\xE0m \u1EA7m \u0129 qu\xE1 \u0111\u1EA5y... Nh\u01B0ng m\xE0... c\u1EA3m \u01A1n ch\xE1u, Wen. B\xE0 ch\xE1u h\u1EB3n \u0111ang m\u1EC9m c\u01B0\u1EDDi."
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Wen
    textKey: "Ch\xE1u kh\xF4ng l\xE0m m\u1ED9t m\xECnh \u0111\xE2u \xF4ng \u1EA1. Nh\u1EDD c\xF3 c\u1EA3 thung l\u0169ng chung tay, khu v\u01B0\u1EDDn m\u1EDBi s\u1ED1ng l\u1EA1i \u0111\u01B0\u1EE3c."
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Tinh Linh Lumi
    textKey: "N\xE0o, c\u1EA7m l\u1EA5y C\xE1nh Hoa Hy V\u1ECDng \u0111i Wen! T\u1EEB gi\u1EDD c\u1EADu c\xF3 th\u1EC3 b\u1EA5m [Q] d\xF9ng Xung \xC1nh Tr\u0103ng b\u1EA5t c\u1EE9 l\xFAc n\xE0o!"
    portraitOverride: {fileID: 0}
    speakerId: 
    requiredFlag: 
    blockedFlag: 
  choices: []
