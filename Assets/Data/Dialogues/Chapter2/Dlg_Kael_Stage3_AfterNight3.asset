  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Kael_Stage3_AfterNight3
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_kael_s3_after_night3
  lines:
  - speakerNameKey: "\xD4ng Kael"
    textKey: "B\xE1c Otis \u0111\u01B0a ch\xE1u xem s\u1ED5 ghi ch\xE9p \u0111\xEAm b\xE3o r\u1ED3i sao... Ch\u1EADc, \u0111\xFAng l\xE0 \u0111\xEAm n\xE0o t\xF4i c\u0169ng l\xE9n b\xE0o g\u1ED7 gia c\u1ED1 ch\xE2n c\u1EA7u th\u1EADt."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Kael"
    textKey: "C\u1EA7m l\u1EA5y N\u1EEDa \u0110\xE8n B\xE3o C\u1ED5 n\xE0y \u0111i Wen. N\u0103m x\u01B0a t\xF4i v\xE0 Mara t\u1EF1 tay r\xE8n n\xF3 cho L\u1EC5 Trao H\u1EA1t \u0111\u1EA7u ti\xEAn. N\u1EEDa c\xF2n l\u1EA1i b\u1ECB n\u01B0\u1EDBc cu\u1ED1n v\xE0o \u0110\u1EA7m L\u1EA7y B\u1EDD T\xE2y r\u1ED3i."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: Tinh Linh Lumi
    textKey: "N\u1EBFu t\xECm \u0111\u1EE7 hai n\u1EEDa \u0111\xE8n b\xE3o, \xC1nh Soi c\u1EE7a Lumi s\u1EBD d\u1EF1ng l\u1EA1i \u0111\u01B0\u1EE3c k\xFD \u1EE9c th\u1EADt s\u1EF1 c\u1EE7a \u0111\xEAm b\xE3o n\u0103m \u1EA5y \u0111\xF3 Wen!"
    portraitOverride: {fileID: 0}
    speakerId: lumi
    requiredFlag: 
    blockedFlag: 
