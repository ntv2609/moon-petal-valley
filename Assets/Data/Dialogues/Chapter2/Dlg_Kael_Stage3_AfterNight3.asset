  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Kael_Stage3_AfterNight3
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_kael_s3_after_night3
  lines:
  - speakerNameKey: "\xD4ng Kael"
    textKey: "B\xE1c Otis \u0111\u01B0a ch\xE1u xem s\u1ED5 ghi ch\xE9p \u0111\xEAm b\xE3o 3 n\u0103m tr\u01B0\u1EDBc r\u1ED3i sao... Ch\u1EADc, \u0111\xFAng l\xE0 \u0111\xEAm n\xE0o t\xF4i c\u0169ng l\xE9n b\xE0o g\u1ED7 gia c\u1ED1 ch\xE2n c\u1EA7u th\u1EADt."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Kael"
    textKey: "C\u1EA7m l\u1EA5y Khung \u0110\u1ED3ng \u0110\xE8n B\xE3o n\xE0y \u0111i Wen. Chao K\xEDnh b\u1ECB b\xE3o cu\u1ED1n v\xE0o \u0110\u1EA7m L\u1EA7y B\u1EDD T\xE2y r\u1ED3i, nh\u01B0ng s\u01B0\u01A1ng trong \u0111\xF3 d\xE0y l\u1EAFm."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Kael"
    textKey: "Khung \u0111\xE8n n\xE0y h\u1EBFt d\u1EA7u r\u1ED3i. Ch\xE1u mang sang B\u1EDD T\xE2y nh\u1EDD b\xE0 Mara ch\xE2m ch\xFAt D\u1EA7u \u0110\xE8n B\xE3o, ng\u1ECDn l\u1EEDa \u0111\xF3 s\u1EBD xua tan s\u01B0\u01A1ng m\xF9 m\u1EDF l\u1ED1i v\xE0o \u0110\u1EA7m L\u1EA7y."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
