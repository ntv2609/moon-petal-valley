    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE1c Otis"
    textKey: "T\u1ED1i nay 18:30 s\u1EBD l\xE0 \u0110\xEAm Chuy\u1EC1n \u0110\xE8n. Ch\xE1u nh\u1EDB chu\u1EA9n b\u1ECB \u0111\u1EA7y Th\u1EC3 l\u1EF1c, d\xF9ng \xC1nh Soi c\u1EE7a Lumi xua l\u0169 B\u01B0\u1EDBm H\xFAt S\xE1ng v\xE0 gi\u1EEF s\xE1ng t\u1ED1i thi\u1EC3u 4 c\u1ED9t \u0111\xE8n c\u1EA7u nh\xE9!"
