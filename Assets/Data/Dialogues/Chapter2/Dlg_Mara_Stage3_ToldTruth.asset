  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Mara_Stage3_ToldTruth
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_mara_s3_told_truth
  lines:
  - speakerNameKey: Wen
    textKey: "B\xE0 Mara \u01A1i, \xF4ng Kael g\u1EEDi ch\xE1u Khung \u0110\u1ED3ng \u0110\xE8n B\xE3o. B\xE1c Otis k\u1EC3 \u0111\xEAm b\xE3o 3 n\u0103m tr\u01B0\u1EDBc \xF4ng \u1EA5y c\u1EAFt c\xE1p l\xE0 \u0111\u1EC3 c\u1EE9u b\u1EBFn nh\xE0 b\xE0!"
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Khung \u0111\xE8n n\u0103m x\u01B0a... \xD4ng \u1EA5y v\u1EABn gi\u1EEF k\u1EF9 \u0111\u1EBFn v\u1EADy sao? \u0110\u1EC3 t\xF4i ch\xE2m ch\xFAt D\u1EA7u \u0110\xE8n B\xE3o v\xE0o cho ch\xE1u."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "\u0110\xE8n s\xE1ng r\u1ED3i \u0111\u1EA5y! Ng\u1ECDn l\u1EEDa n\xE0y \u0111\u1EE7 xua tan s\u01B0\u01A1ng m\xF9 ch\u1EB7n l\u1ED1i l\xEAn \u0110\u1EA7m L\u1EA7y ph\xEDa B\u1EAFc. Ch\xE1u v\xE0o \u0111\xF3 t\xECm Chao K\xEDnh v\u1EC1 soi l\u1EA1i chuy\u1EC7n c\u0169, t\xF4i s\u1EBD tin."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  choices: []
