  lines:
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ch\xE1u v\u1EABn gi\u1EA5u t\xF4i chuy\u1EC7n g\xEC b\xEAn B\u1EDD \u0110\xF4ng \u0111\xFAng kh\xF4ng? Th\xF4i, t\xF4i c\u0169ng quen v\u1EDBi s\u1EF1 im l\u1EB7ng r\u1ED3i."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "N\u1EBFu ch\xE1u th\u1EADt s\u1EF1 mu\u1ED1n bi\u1EBFt \u0111\xEAm b\xE3o n\u0103m x\u01B0a \u0111\xE3 x\u1EA3y ra chuy\u1EC7n g\xEC, c\u1EE9 l\xEAn \u0110\u1EA7m L\u1EA7y ph\xEDa B\u1EAFc B\u1EDD T\xE2y t\xECm n\u1EEDa chi\u1EBFc \u0111\xE8n b\xE3o b\u1ECB th\u1EA5t l\u1EA1c \u0111i."
