  m_Script: {fileID: 11500000, guid: c597d33f149cdf04299a1085b446df21, type: 3}
  m_Name: Dlg_Mara_Stage3_KeptSecret
  m_EditorClassIdentifier: Assembly-CSharp::MoonpetalValley.Data.DialogueData
  dialogueID: dlg_mara_s3_kept_secret
  lines:
  - speakerNameKey: Wen
    textKey: "B\xE0 Mara \u01A1i, \xF4ng Kael \u0111\u01B0a ch\xE1u Khung \u0110\u1ED3ng \u0110\xE8n B\xE3o c\u1ED5. B\xE0 cho ch\xE1u xin ch\xFAt D\u1EA7u \u0110\xE8n B\xE3o \u0111\u1EC3 v\xE0o \u0110\u1EA7m L\u1EA7y t\xECm ph\u1EA7n k\xEDnh c\xF2n l\u1EA1i nh\xE9."
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ch\xE1u v\u1EABn gi\u1EA5u t\xF4i chuy\u1EC7n g\xEC b\xEAn B\u1EDD \u0110\xF4ng \u0111\xFAng kh\xF4ng? Th\xF4i, th\u1EA5y chi\u1EBFc khung \u0111\u1ED3ng c\u0169 n\xE0y t\xF4i c\u0169ng m\u1EE7i l\xF2ng... \u0111\u1EC3 t\xF4i ch\xE2m d\u1EA7u cho."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ng\u1ECDn l\u1EEDa d\u1EA7u b\xE3o \u0111\xE3 ch\xE1y! S\u01B0\u01A1ng m\xF9 l\u1ED1i l\xEAn \u0110\u1EA7m L\u1EA7y ph\xEDa B\u1EAFc \u0111\xE3 tan b\u1EDBt, ch\xE1u v\xE0o \u0111\xF3 t\xECm Chao K\xEDnh \u0111i r\u1ED3i c\u1EA9n th\u1EADn \u0111\xE1m qu\xE1i nh\xE9."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
