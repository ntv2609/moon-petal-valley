  lines:
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ch\xE1u d\u1ECDn s\u1EA1ch \u0111\xE1m b\u1ECD gai trong \u0110\u1EA7m L\u1EA7y B\u1EDD T\xE2y r\u1ED3i sao? C\u1EA3 n\u1EEDa chi\u1EBFc \u0111\xE8n b\xE3o c\u0169 n\u1EEFa..."
    portraitOverride: {fileID: 0}
    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "Ng\u1ECDn \u0111\xE8n \u0111\xF3 v\u1EABn c\xF2n h\u01A1i \u1EA5m c\u1EE7a \u0111\xEAm b\xE3o n\u0103m \u1EA5y \u0111\u1EA5y. Ch\xE1u th\u1EED d\xF9ng \xE1nh s\xE1ng c\u1EE7a b\xE9 Lumi soi ngay \u1EDF \u0110\u1EA7m L\u1EA7y v\xE0 m\u1ED1 c\u1EA7u B\u1EDD T\xE2y xem sao."
