  dialogueID: dlg_kael_s2_investigating
  lines:
  - speakerNameKey: Wen
    textKey: "\xD4ng Kael \u01A1i, t\u1ED1i qua ch\xE1u th\u1EA5y phoi b\xE0o g\u1ED7 lim m\u1EDBi tinh r\u01A1i ngay g\u1EA7n m\u1ED1 c\u1EA7u..."
    portraitOverride: {fileID: 0}
    speakerId: wen
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Kael"
    textKey: "Kh\u1EE5... th\xEC x\u01B0\u1EDFng t\xF4i b\xE0o g\u1ED7 su\u1ED1t ng\xE0y, gi\xF3 th\u1ED5i bay ra \u0111\xF3 ch\u1EE9 c\xF3 g\xEC l\u1EA1 \u0111\xE2u!"
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "\xD4ng Kael"
    textKey: "Ch\xE1u c\u1EE9 ch\xE8o \u0111\xF2 sang B\u1EDD T\xE2y g\u1EB7p b\xE0 Mara r\u1ED3i ki\u1EC3m tra n\u1ED1t quanh b\u1EDD s\xF4ng xem sao."
    portraitOverride: {fileID: 0}
    speakerId: kael
    requiredFlag: 
    blockedFlag: 
