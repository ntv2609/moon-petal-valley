    speakerId: mara
    requiredFlag: 
    blockedFlag: 
  - speakerNameKey: "B\xE0 Mara"
    textKey: "C\u1EA3m \u01A1n ch\xE1u v\xE0 b\xE9 Lumi. Khi n\xE0o m\u1EC7t m\u1ECFi, c\u1EE9 ch\u1EA1y qua c\u1EA7u gh\xE9 B\u1EDD T\xE2y u\u1ED1ng ch\xE9n tr\xE0 sen n\xF3ng v\u1EDBi t\xF4i nh\xE9."
